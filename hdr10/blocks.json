  "html": " <!-- T123 --> <div class=\"t123\"> <div class=\"t-container_100 \"> <div class=\"t-width t-width_100 \"> <!-- nominify begin --> <style> .shefiko-brands { width: 100%; overflow: hidden; padding: 38px 0 42px; background: #fff; font-family: Arial, sans-serif; } .shefiko-brands__inner { max-width: 1160px; width: calc(100% - 40px); margin-left: auto; margin-right: auto; } .shefiko-brands__title { margin: 0 0 28px; padding: 0; font-size: 36px; line-height: 1.15; font-weight: 700; color: #202020; } .shefiko-brands__viewport { width: 100%; overflow: hidden; -webkit-mask-image: linear-gradient( to right, transparent 0, #000 5%, #000 95%, transparent 100% ); mask-image: linear-gradient( to right, transparent 0, #000 5%, #000 95%, transparent 100% ); } .shefiko-brands__track { display: flex; width: max-content; align-items: center; gap: 68px; animation: shefikoScroll 44s linear infinite; will-change: transform; } .shefiko-brands__viewport:hover .shefiko-brands__track { animation-play-state: paused; } .shefiko-brand { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 145px; height: 64px; text-decoration: none; opacity: .82; transition: opacity .25s ease, transform .25s ease; } .shefiko-brand:hover { opacity: 1; transform: translateY(-3px); } .shefiko-brand img { display: block; width: auto; height: auto; max-width: 145px; max-height: 48px; object-fit: contain; transition: transform .25s ease; } .shefiko-brand:hover img { transform: scale(1.06); } /* ========================= ИНДИВИДУАЛЬНЫЕ ЛОГОТИПЫ ========================= */ /* Bagerstat */ .shefiko-brand--bagerstat img { max-width: 155px; } /* Hochland */ .shefiko-brand--hochland img { max-width: 145px; max-height: 52px; } /* We Fry — БЕЗ ЧЁРНОЙ ПЛАШКИ */ .shefiko-brand--wefry { background: transparent; padding: 0; } .shefiko-brand--wefry img { max-width: 145px; max-height: 48px; } /* Мистраль */ .shefiko-brand--mistral img { max-width: 145px; max-height: 50px; } /* Националь */